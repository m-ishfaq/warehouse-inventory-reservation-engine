APP_NAME="Warehouse Inventory Reservation Engine"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# MySQL 8.0.16+ is required, not SQLite. The engine depends on two InnoDB
# features SQLite cannot provide:
#   1. SELECT ... FOR UPDATE row-level locking (concurrent reservation safety)
#   2. Enforced CHECK constraints (structural prevention of negative stock)
# ---------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=warehouse_inventory
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Queued shipment processing. Use 'sync' only for quick manual experiments —
# the retry/idempotency behaviour is only meaningful on a real queue.
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log

# ---------------------------------------------------------------------------
# Inventory engine
# ---------------------------------------------------------------------------
INVENTORY_RESERVATION_TTL=30
INVENTORY_EXPIRY_BATCH=500
INVENTORY_ALLOW_PARTIAL=false
INVENTORY_TX_ATTEMPTS=3
INVENTORY_IDEMPOTENCY_RETENTION=72

# Bearer token for the mutating API endpoints. Generate your own:
#   php artisan inventory:token
INVENTORY_API_TOKEN=
INVENTORY_API_RATE_LIMIT=60

# ---------------------------------------------------------------------------
# Mock shipping provider
# ---------------------------------------------------------------------------
SHIPPING_DRIVER=mock

# Shared secret used to sign provider webhooks (HMAC-SHA256).
SHIPPING_WEBHOOK_SECRET=change-me-in-production
SHIPPING_WEBHOOK_TOLERANCE=300

# Leave empty for randomised behaviour. Set to one of:
#   success | permanent_failure | timeout | duplicate_confirmation | delayed_success
SHIPPING_MOCK_OUTCOME=
SHIPPING_MOCK_DELAY=2

VITE_APP_NAME="${APP_NAME}"
